{
 "name": "Cardiovascular Response to Nerve Stimulation",
 "summary": "Heart rate, blood pressure and breathing responses to each stimulation, dose-response, thresholds and the neural fulcrum.",
 "description": "For nerve-stimulation experiments in humans or animals: imports recordings from common acquisition formats into NWB (physio-import), finds every stimulation train and its parameters (stim-events), computes heart rate and heart rate variability from ECG (ecg-hrv) and beat-to-beat blood pressure, respiration and baroreflex sensitivity (bp-resp), measures the response to each train with dose-response fits, thresholds, response surfaces and the neural fulcrum (stim-dose-response), and writes an HTML/PDF report. Species presets for human, pig, dog, rabbit, rat and mouse. Recordings without blood pressure or respiration still run. Research use only.",
 "inputs": [
  {
   "id": "recordings",
   "name": "Physiological recordings",
   "description": "Recordings as your acquisition system exports them: EDF/BDF, PhysioNet WFDB, Axon ABF, Spike2 .smr, BIOPAC .acq, NWB, HDF5, MATLAB .mat, CSV/TSV/XLSX, WAV, or BIDS physiological recordings; optionally a channels-map.csv, a stim-map.yaml with parameter tables, and subject metadata (BIDS participants.tsv or SDS subjects.xlsx).",
   "position": {
    "x": 450,
    "y": 0
   }
  }
 ],
 "processors": [
